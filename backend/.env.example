# Docker'dagi baza (docker-compose.yml). Lokal parol — faqat ishlab chiqish uchun.
DATABASE_URL="postgresql://elma:elma@localhost:5433/elma_payroll"

# DB testlari (npm run test:db) uchun alohida baza — asosiy ma'lumotga tegmaydi.
TEST_DATABASE_URL="postgresql://elma:elma@localhost:5433/elma_payroll_test"

# Seed yaratadigan admin foydalanuvchi paroli (argon2 bilan xeshlanadi).
SEED_ADMIN_PASSWORD="change-me"

# JWT imzo kaliti — kamida 32 belgi, aks holda server ishga tushmaydi.
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="bu-yerga-kamida-32-belgili-tasodifiy-kalit-yozing"
# Token muddati (refresh token yo'q — muddat tugasa qayta login).
JWT_EXPIRES_IN="8h"
